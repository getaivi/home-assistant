   "template": "switchboard",
   "name": "Porch",
   "ask": "Fill the remaining slots",
   "bindings": {
    "actions": [
     "input_boolean.front_door",
     "input_boolean.porch_light",
     "input_boolean.fountain"
    ],
    "icon": "house.fill",
    "accent": "green"
   },
   "expect": [
    {
     "rows": "actions",
     "count": 8,
     "keeps": true
    },
    {
